---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ThemeToggle from '@/components/ThemeToggle.astro';
import CardPreview from '@/components/CardPreview.astro';
import ControlPanel from '@/components/ControlPanel.astro';
import CardFilterBar from '@/components/CardFilterBar.astro';
import SampleReadmeSection from '@/components/SampleReadmeSection.astro';
import Footer from '@/components/Footer.astro';
---

<BaseLayout>
  <header class="app-header">
    <div class="header-top-row">
      <div class="logo">
        <svg
          class="logo-icon"
          viewBox="0 0 24 24"
          width="36"
          height="36"
          fill="none"
          stroke="url(#logo-grad)"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <defs>
            <linearGradient id="logo-grad" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#38bdf8"></stop>
              <stop offset="100%" stop-color="#a855f7"></stop>
            </linearGradient>
          </defs>
          <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
        </svg>
        <h1>GitCard <span class="accent-text">Studio</span></h1>
      </div>
      <ThemeToggle />
    </div>
    <p class="subtitle" data-i18n="header_subtitle">
      Potencia la visibilidad de tus proyectos. Genera métricas y tarjetas estéticas en caliente
      para tu README.md.
    </p>
    <!-- Header Badges Row -->
    <div class="header-badges-row">
      <div class="status-pill">
        <span class="status-dot-pulse"></span>
        <span>API Operational (Ultra-Fast Cache)</span>
      </div>
      <!-- Live Metrics counter -->
      <div class="hidden metrics-badge" id="metrics-badge">
        <span class="pulse-dot"></span>
        <span style="display: inline-flex; align-items: center; gap: 4px;">
          <span data-i18n="header_metrics_label">Usuarios usando las cards: </span>
          <strong id="metrics-count">Cargando...</strong>
        </span>
      </div>
    </div>
  </header>

  <main class="main-content">
    <!-- Left Column Wrapper -->
    <div class="left-column" style="display: flex; flex-direction: column; gap: 24px; width: 100%">
      <ControlPanel />
    </div>

    <!-- Right Panel: Live Preview & Code -->
    <section class="preview-panel">
      <!-- Live Preview -->
      <div class="preview-card glass-card">
        <h2 class="section-title" data-i18n="preview_title">Vista Previa</h2>

        <CardFilterBar />

        <div class="cards-preview-container">
          <!-- Profile Views Badge Preview -->
          <CardPreview
            id="views"
            title="Contador de Visitas del Perfil"
            codeLabel="Contador de Visitas"
            category="badges"
            frameStyle="min-height: auto; padding: 20px 0;"
            imgStyle="max-height: 20px; object-fit: contain;"
          >
            <svg
              slot="placeholder-icon"
              class="placeholder-svg"
              viewBox="0 0 24 24"
              width="36"
              height="36"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
              <circle cx="12" cy="12" r="3"></circle>
            </svg>

            <!-- Visitor Counter Options -->
            <div
              slot="options"
              style="padding: 16px; border: 1px solid var(--glass-border); border-radius: 12px; background: rgba(56,189,248,0.04); display: flex; flex-direction: column; gap: 12px; margin-top: 12px; margin-bottom: 12px;"
            >
              <span
                class="input-label"
                style="font-weight: 600; display: flex; align-items: center; gap: 8px;"
              >
                <svg
                  viewBox="0 0 24 24"
                  width="16"
                  height="16"
                  fill="none"
                  stroke="#38bdf8"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  ><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle
                    cx="12"
                    cy="12"
                    r="3"></circle></svg
                >
                Contador de Visitas del Perfil
              </span>

              <div class="input-group" style="margin-bottom: 0;">
                <label for="views-label" class="input-label" style="font-size: 0.8rem;"
                  >Etiqueta (Label)</label
                >
                <div class="input-wrapper" style="height: 36px;">
                  <input
                    type="text"
                    id="views-label"
                    placeholder="Profile views"
                    style="font-size: 0.85rem;"
                    value="Profile views"
                    autocomplete="off"
                  />
                </div>
              </div>

              <div style="display: flex; gap: 12px;">
                <div class="input-group" style="flex: 1; margin-bottom: 0;">
                  <label for="views-color" class="input-label" style="font-size: 0.8rem;"
                    >Color acento (Opcional)</label
                  >
                  <div class="input-wrapper" style="height: 36px;">
                    <input
                      type="text"
                      id="views-color"
                      placeholder="ej. blue o hex"
                      style="font-size: 0.85rem;"
                      autocomplete="off"
                    />
                  </div>
                </div>

                <div class="input-group" style="flex: 1; margin-bottom: 0;">
                  <label for="views-style" class="input-label" style="font-size: 0.8rem;"
                    >Estilo</label
                  >
                  <select
                    id="views-style"
                    style="background: rgba(255,255,255,0.05); border: 1px solid var(--glass-border); color: var(--text-primary); border-radius: 8px; padding: 0 10px; font-size: 0.85rem; height: 36px; cursor: pointer; width: 100%; outline: none;"
                  >
                    <option
                      value="flat"
                      style="background: var(--glass-bg); color: var(--text-primary);">flat</option
                    >
                    <option
                      value="flat-square"
                      style="background: var(--glass-bg); color: var(--text-primary);"
                      >flat-square</option
                    >
                  </select>
                </div>
              </div>
            </div>
          </CardPreview>

          <!-- Stats Card Preview -->
          <CardPreview
            id="stats"
            title="Tarjeta de Estadísticas"
            codeLabel="Estadísticas Generales"
            category="stats"
          >
            <svg
              slot="placeholder-icon"
              class="placeholder-svg"
              viewBox="0 0 24 24"
              width="48"
              height="48"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <line x1="18" y1="20" x2="18" y2="10"></line>
              <line x1="12" y1="20" x2="12" y2="4"></line>
              <line x1="6" y1="20" x2="6" y2="14"></line>
            </svg>
          </CardPreview>

          <!-- Languages Card Preview -->
          <CardPreview
            id="languages"
            title="Tarjeta de Lenguajes"
            codeLabel="Lenguajes Más Usados"
            category="stats"
          >
            <svg
              slot="placeholder-icon"
              class="placeholder-svg"
              viewBox="0 0 24 24"
              width="48"
              height="48"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M21.21 15.89A10 10 0 1 1 8 2.83"></path>
              <path d="M22 12A10 10 0 0 0 12 2v10z"></path>
            </svg>
          </CardPreview>

          <!-- Featured Repo Card Preview -->
          <CardPreview
            id="repo"
            title="Tarjeta de Repositorio Destacado"
            codeLabel="Repositorio Destacado"
            category="repos"
          >
            <svg
              slot="placeholder-icon"
              class="placeholder-svg"
              viewBox="0 0 24 24"
              width="48"
              height="48"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"
              ></path>
            </svg>
          </CardPreview>

          <!-- Rank Card Preview -->
          <CardPreview
            id="rank"
            title="Tarjeta de Rango de Desarrollador"
            codeLabel="Rango de Desarrollador"
            category="stats"
          >
            <svg
              slot="placeholder-icon"
              class="placeholder-svg"
              viewBox="0 0 24 24"
              width="48"
              height="48"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <circle cx="12" cy="8" r="7"></circle>
              <polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"></polyline>
            </svg>
          </CardPreview>

          <!-- Streak Stats Card Preview -->
          <CardPreview
            id="streak"
            title="Tarjeta de Racha de Contribuciones"
            codeLabel="Racha de Contribuciones"
            category="activity"
          >
            <svg
              slot="placeholder-icon"
              class="placeholder-svg"
              viewBox="0 0 24 24"
              width="48"
              height="48"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"></path>
            </svg>
          </CardPreview>

          <!-- Trophies Card Preview -->
          <CardPreview
            id="trophies"
            title="Tarjeta de Trofeos"
            codeLabel="Trofeos de GitHub"
            category="stats"
          >
            <svg
              slot="placeholder-icon"
              class="placeholder-svg"
              viewBox="0 0 24 24"
              width="48"
              height="48"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"></path>
              <path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"></path>
              <path d="M4 22h16"></path>
              <path d="M10 14.66V17c0 .55-.45 1-1 1H4v2h16v-2h-5c-.55 0-1-.45-1-1v-2.34"></path>
              <path d="M12 2a6 6 0 0 1 6 6v5a6 6 0 0 1-6 6 6 6 0 0 1-6-6V8a6 6 0 0 1 6-6z"></path>
            </svg>
          </CardPreview>

          <!-- Top Repositories Card Preview -->
          <CardPreview
            id="top-repos"
            title="Top Repositorios"
            codeLabel="Top Repositorios"
            category="repos"
          >
            <svg
              slot="placeholder-icon"
              class="placeholder-svg"
              viewBox="0 0 24 24"
              width="48"
              height="48"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path
                d="M3 2.75A2.75 2.75 0 0 1 5.75 0h14.5a.75.75 0 0 1 .75.75v20.5a.75.75 0 0 1-.75.75h-6a.75.75 0 0 1 0-1.5h5.25v-4H5.75A2.75 2.75 0 0 1 3 14.25v-11.5z"
              ></path>
            </svg>
          </CardPreview>

          <!-- GitHub Sponsors Card Preview -->
          <CardPreview
            id="sponsors"
            title="GitHub Sponsors"
            codeLabel="GitHub Sponsors"
            category="repos"
          >
            <svg
              slot="placeholder-icon"
              class="placeholder-svg"
              viewBox="0 0 24 24"
              width="48"
              height="48"
              fill="none"
              stroke="#ea4aaa"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path
                d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"
              ></path>
            </svg>
          </CardPreview>

          <!-- Commit Activity Grid Card Preview -->
          <CardPreview
            id="commit-activity"
            title="Matriz de Hábitos de Commit"
            codeLabel="Matriz de Hábitos"
            category="activity"
          >
            <svg
              slot="placeholder-icon"
              class="placeholder-svg"
              viewBox="0 0 24 24"
              width="48"
              height="48"
              fill="none"
              stroke="#4ade80"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
              <line x1="3" y1="9" x2="21" y2="9"></line>
              <line x1="3" y1="15" x2="21" y2="15"></line>
              <line x1="9" y1="3" x2="9" y2="21"></line>
              <line x1="15" y1="3" x2="15" y2="21"></line>
            </svg>
          </CardPreview>

          <!-- Today's Commit Status Badge Preview -->
          <CardPreview
            id="today-status"
            title="Estado de Actividad de Hoy"
            codeLabel="Estado de Actividad Hoy"
            category="activity"
          >
            <svg
              slot="placeholder-icon"
              class="placeholder-svg"
              viewBox="0 0 24 24"
              width="48"
              height="48"
              fill="none"
              stroke="#ff7edb"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
          </CardPreview>

          <!-- Coding Productivity Timeline Card Preview -->
          <CardPreview
            id="timeline-matrix"
            title="Línea de Tiempo de Productividad"
            codeLabel="Línea de Tiempo"
            category="activity"
          >
            <svg
              slot="placeholder-icon"
              class="placeholder-svg"
              viewBox="0 0 24 24"
              width="48"
              height="48"
              fill="none"
              stroke="#38bdf8"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <line x1="12" y1="20" x2="12" y2="10"></line>
              <line x1="18" y1="20" x2="18" y2="4"></line>
              <line x1="6" y1="20" x2="6" y2="16"></line>
            </svg>
          </CardPreview>
        </div>
      </div>

      <SampleReadmeSection />
    </section>
  </main>

  <div id="toast-container" class="toast-container" aria-live="polite"></div>

  <Footer />
</BaseLayout>

<script>
  import {
    generateSampleReadme,
    renderLiveReadmeHtml,
    type CardItem
  } from '@/utils/readmeGenerator';
  import { buildCardUrls } from '@/utils/cardUrls';
  import { t, updateDomTranslations } from '@/utils/i18n';

  // Elements
  const usernameInput = document.getElementById('username-input') as HTMLInputElement | null;
  const repoInput = document.getElementById('repo-input') as HTMLInputElement | null;
  const themesContainer = document.getElementById('themes-container');
  const themeOptions = document.querySelectorAll('.theme-option') as NodeListOf<HTMLButtonElement>;

  const statsImg = document.getElementById('stats-img') as HTMLImageElement | null;
  const statsPlaceholder = document.getElementById('stats-placeholder');

  const languagesImg = document.getElementById('languages-img') as HTMLImageElement | null;
  const languagesPlaceholder = document.getElementById('languages-placeholder');

  const repoImg = document.getElementById('repo-img') as HTMLImageElement | null;
  const repoPlaceholder = document.getElementById('repo-placeholder');

  const rankImg = document.getElementById('rank-img') as HTMLImageElement | null;
  const rankPlaceholder = document.getElementById('rank-placeholder');

  const streakImg = document.getElementById('streak-img') as HTMLImageElement | null;
  const streakPlaceholder = document.getElementById('streak-placeholder');

  const trophiesImg = document.getElementById('trophies-img') as HTMLImageElement | null;
  const trophiesPlaceholder = document.getElementById('trophies-placeholder');

  const topReposImg = document.getElementById('top-repos-img') as HTMLImageElement | null;
  const topReposPlaceholder = document.getElementById('top-repos-placeholder');

  const sponsorsImg = document.getElementById('sponsors-img') as HTMLImageElement | null;
  const sponsorsPlaceholder = document.getElementById('sponsors-placeholder');

  const commitActivityImg = document.getElementById(
    'commit-activity-img'
  ) as HTMLImageElement | null;
  const commitActivityPlaceholder = document.getElementById('commit-activity-placeholder');

  const todayStatusImg = document.getElementById('today-status-img') as HTMLImageElement | null;
  const todayStatusPlaceholder = document.getElementById('today-status-placeholder');

  const timelineMatrixImg = document.getElementById(
    'timeline-matrix-img'
  ) as HTMLImageElement | null;
  const timelineMatrixPlaceholder = document.getElementById('timeline-matrix-placeholder');

  const viewsImg = document.getElementById('views-img') as HTMLImageElement | null;
  const viewsPlaceholder = document.getElementById('views-placeholder');

  const codeBlockWrappers = document.querySelectorAll('.code-block-wrapper');
  const markdownStatsCode = document.getElementById('markdown-stats-code');
  const markdownLanguagesCode = document.getElementById('markdown-languages-code');
  const markdownRepoCode = document.getElementById('markdown-repo-code');
  const markdownRankCode = document.getElementById('markdown-rank-code');
  const markdownStreakCode = document.getElementById('markdown-streak-code');
  const markdownTrophiesCode = document.getElementById('markdown-trophies-code');
  const markdownTopReposCode = document.getElementById('markdown-top-repos-code');
  const markdownSponsorsCode = document.getElementById('markdown-sponsors-code');
  const markdownCommitActivityCode = document.getElementById('markdown-commit-activity-code');
  const markdownTodayStatusCode = document.getElementById('markdown-today-status-code');
  const markdownTimelineMatrixCode = document.getElementById('markdown-timeline-matrix-code');
  const markdownViewsCode = document.getElementById('markdown-views-code');

  const btnCopyStats = document.getElementById('btn-copy-stats');
  const btnCopyLanguages = document.getElementById('btn-copy-languages');
  const btnCopyRepo = document.getElementById('btn-copy-repo');
  const btnCopyRank = document.getElementById('btn-copy-rank');
  const btnCopyStreak = document.getElementById('btn-copy-streak');
  const btnCopyTrophies = document.getElementById('btn-copy-trophies');
  const btnCopyTopRepos = document.getElementById('btn-copy-top-repos');
  const btnCopySponsors = document.getElementById('btn-copy-sponsors');
  const btnCopyViews = document.getElementById('btn-copy-views');

  const viewsLabel = document.getElementById('views-label') as HTMLInputElement | null;
  const viewsColor = document.getElementById('views-color') as HTMLInputElement | null;
  const viewsStyle = document.getElementById('views-style') as HTMLSelectElement | null;

  // Metrics Elements
  const metricsBadge = document.getElementById('metrics-badge');
  const metricsCount = document.getElementById('metrics-count');

  // Private Stats Elements
  const privateStatsBadge = document.getElementById('private-stats-badge');
  const tokenFormContainer = document.getElementById('token-form-container');

  // Global Loading Overlay
  const globalLoading = document.getElementById('global-loading');

  // Application State
  let currentTheme = 'dark';
  let currentUsername = '';
  let currentRepo = '';
  let currentCardWidth = ''; // empty = default 495px
  let currentLocale = 'es';
  let currentReadmeLayout: 'vertical' | 'grid' = 'vertical';

  let completedImagesCount = 0;
  const totalImagesToLoad = 12; // stats, languages, repo, rank, streak, trophies, top-repos, sponsors, commit-activity, today-status, timeline-matrix, views
  let isGeneratingAllCards = false;
  let isUsingCustomTheme = false;

  const localeSelect = document.getElementById('locale-select') as HTMLSelectElement | null;

  localeSelect?.addEventListener('change', () => {
    currentLocale = localeSelect.value;
    updateDomTranslations(currentLocale);
    const newUrl = new URL(window.location.href);
    newUrl.searchParams.set('locale', currentLocale);
    window.history.pushState({}, '', newUrl.toString());
    if (currentUsername) {
      updateCards();
    }
  });

  // --- Card Category Filter Tabs with Stagger Animation ---
  const filterTabs = document.querySelectorAll('.filter-tab') as NodeListOf<HTMLButtonElement>;

  filterTabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      filterTabs.forEach((t) => t.classList.remove('active'));
      tab.classList.add('active');
      const selectedCategory = tab.getAttribute('data-filter') || 'all';

      const cardWrappers = document.querySelectorAll('.card-preview-wrapper');
      let visibleIdx = 0;
      cardWrappers.forEach((wrapper) => {
        const htmlEl = wrapper as HTMLElement;
        const cat = wrapper.getAttribute('data-category');
        if (selectedCategory === 'all' || cat === selectedCategory) {
          htmlEl.classList.remove('cat-hidden');
          htmlEl.classList.add('cat-visible', 'stagger-in');
          htmlEl.style.animationDelay = `${visibleIdx * 0.04}s`;
          visibleIdx++;
        } else {
          htmlEl.classList.add('cat-hidden');
          htmlEl.classList.remove('cat-visible', 'stagger-in');
          htmlEl.style.animationDelay = '0s';
        }
      });
    });
  });

  // --- Card Width Control ---
  const widthOptions = document.querySelectorAll('.width-option') as NodeListOf<HTMLButtonElement>;
  const customWidthInput = document.getElementById('custom-width-input') as HTMLInputElement | null;
  const btnApplyWidth = document.getElementById('btn-apply-width');

  function applyPreviewWidth() {
    const wrappers = document.querySelectorAll('.card-preview-wrapper');
    wrappers.forEach((w) => {
      const htmlW = w as HTMLElement;
      if (currentCardWidth === '100%') {
        htmlW.style.maxWidth = '100%';
      } else if (currentCardWidth && !Number.isNaN(Number.parseInt(currentCardWidth, 10))) {
        const pxVal = Number.parseInt(currentCardWidth, 10);
        htmlW.style.maxWidth = `${pxVal + 10}px`;
      } else {
        htmlW.style.maxWidth = '505px';
      }
    });
  }

  widthOptions.forEach((btn) => {
    btn.addEventListener('click', () => {
      widthOptions.forEach((b) => {
        b.style.background = 'transparent';
        b.style.color = 'var(--text-secondary)';
        b.classList.remove('active');
      });
      btn.style.background = 'rgba(88,166,255,0.12)';
      btn.style.color = 'var(--text-primary)';
      btn.classList.add('active');
      const w = btn.dataset.width || '';
      currentCardWidth = w === 'default' ? '' : w;
      if (customWidthInput) customWidthInput.value = '';
      applyPreviewWidth();
      if (currentUsername) updateCards();
    });
  });

  btnApplyWidth?.addEventListener('click', () => {
    const val = customWidthInput ? customWidthInput.value.trim() : '';
    if (val) {
      currentCardWidth = val;
      widthOptions.forEach((b) => {
        b.style.background = 'transparent';
        b.style.color = 'var(--text-secondary)';
        b.classList.remove('active');
      });
      applyPreviewWidth();
      if (currentUsername) updateCards();
    }
  });

  // --- SVG Themes Selector disabled state ---
  function updateThemeSelectorsState() {
    const hasUser = !!currentUsername;
    themeOptions.forEach((opt) => {
      opt.disabled = !hasUser;
    });
  }
  updateThemeSelectorsState();

  // --- Metrics Load Logic ---
  async function loadMetrics() {
    if (!metricsBadge || !metricsCount) return;

    metricsCount.textContent = 'Cargando...';
    metricsBadge.classList.remove('hidden');

    try {
      const response = await fetch('/api/metrics/users/count');
      if (response.ok) {
        const count = await response.json();
        metricsCount.textContent = Number(count).toLocaleString();
      } else {
        metricsBadge.classList.add('hidden');
      }
    } catch (err) {
      console.warn('Could not fetch usage metrics:', err);
      metricsBadge.classList.add('hidden');
    }
  }

  loadMetrics();

  // --- Custom Theme Color Pickers ---
  const customThemePickerPanel = document.getElementById('custom-theme-picker-panel');
  const pickerBg = document.getElementById('picker-bg') as HTMLInputElement | null;
  const pickerTitle = document.getElementById('picker-title') as HTMLInputElement | null;
  const pickerText = document.getElementById('picker-text') as HTMLInputElement | null;
  const pickerIcon = document.getElementById('picker-icon') as HTMLInputElement | null;
  const pickerBorder = document.getElementById('picker-border') as HTMLInputElement | null;

  // --- SVG Themes Selection logic ---
  themesContainer?.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const option = target.closest('.theme-option') as HTMLButtonElement | null;
    if (!option) return;

    themeOptions.forEach((opt) => opt.classList.remove('active'));
    option.classList.add('active');

    const selectedTheme = option.dataset.theme || 'dark';

    if (selectedTheme === 'custom') {
      isUsingCustomTheme = true;
      currentTheme = 'dark';
      customThemePickerPanel?.classList.remove('hidden');
    } else {
      isUsingCustomTheme = false;
      currentTheme = selectedTheme;
      customThemePickerPanel?.classList.add('hidden');
    }

    if (currentUsername) {
      const newUrl = new URL(window.location.href);
      newUrl.searchParams.set('theme', selectedTheme === 'custom' ? 'dark' : currentTheme);
      window.history.pushState({}, '', newUrl.toString());

      updateCards();
    }
  });

  // Real-time custom color updates
  [pickerBg, pickerTitle, pickerText, pickerIcon, pickerBorder].forEach((picker) => {
    picker?.addEventListener('input', () => {
      if (isUsingCustomTheme && currentUsername) {
        updateCards();
      }
    });
  });

  function getCustomThemeQueryParams(): string {
    if (!isUsingCustomTheme) return '';
    let params = '';
    if (pickerBg && pickerBg.value)
      params += `&bg_color=${encodeURIComponent(pickerBg.value.replace('#', ''))}`;
    if (pickerTitle && pickerTitle.value)
      params += `&title_color=${encodeURIComponent(pickerTitle.value.replace('#', ''))}`;
    if (pickerText && pickerText.value)
      params += `&text_color=${encodeURIComponent(pickerText.value.replace('#', ''))}`;
    if (pickerIcon && pickerIcon.value)
      params += `&icon_color=${encodeURIComponent(pickerIcon.value.replace('#', ''))}`;
    if (pickerBorder && pickerBorder.value)
      params += `&border_color=${encodeURIComponent(pickerBorder.value.replace('#', ''))}`;
    return params;
  }
  // Generate button handler with Event Delegation
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const btn = target.closest('#btn-generate, #btn-generate-auth');
    if (btn) {
      e.preventDefault();
      submitUsername();
    }
  });

  // Enter key support in inputs with Event Delegation
  document.addEventListener('keypress', (e) => {
    if (e.key === 'Enter') {
      const target = e.target as HTMLElement;
      if (target && (target.id === 'username-input' || target.id === 'repo-input')) {
        e.preventDefault();
        submitUsername();
      }
    }
  });

  function submitUsername() {
    const uInput =
      (document.getElementById('username-input') as HTMLInputElement | null) || usernameInput;
    const rInput = (document.getElementById('repo-input') as HTMLInputElement | null) || repoInput;

    const usernameVal = uInput?.value.trim() || currentUsername;
    if (!usernameVal) {
      if (uInput) uInput.focus();
      return;
    }

    currentUsername = usernameVal;
    currentRepo = rInput ? rInput.value.trim() : '';

    const newUrl = new URL(window.location.origin + window.location.pathname);
    newUrl.searchParams.set('user', currentUsername);
    if (currentTheme) {
      newUrl.searchParams.set('theme', currentTheme);
    }
    if (currentLocale && currentLocale !== 'es') {
      newUrl.searchParams.set('locale', currentLocale);
    }
    window.history.pushState({}, '', newUrl.toString());

    updateThemeSelectorsState();
    updateCards();
  }

  // --- Direct Download Handlers (SVG & PNG) ---
  document.addEventListener('click', async (e) => {
    const target = e.target as HTMLElement;
    const downloadSvgBtn = target.closest('.btn-download-svg') as HTMLButtonElement | null;
    const downloadPngBtn = target.closest('.btn-download-png') as HTMLButtonElement | null;

    if (downloadSvgBtn) {
      const parent = downloadSvgBtn.closest('.card-preview-wrapper');
      const img = parent?.querySelector('.preview-img') as HTMLImageElement | null;
      const cardId = downloadSvgBtn.id.replace('btn-download-svg-', '');
      if (!img || !img.src) return;

      try {
        const res = await fetch(img.src);
        const svgText = await res.text();
        const blob = new Blob([svgText], { type: 'image/svg+xml' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `github-${currentUsername || 'user'}-${cardId}.svg`;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
        window.dispatchEvent(
          new CustomEvent('app:toast', {
            detail: { message: '¡Imagen SVG vectorial descargada!', type: 'success' }
          })
        );
      } catch (err) {
        console.error('Error downloading SVG:', err);
      }
    }

    if (downloadPngBtn) {
      const parent = downloadPngBtn.closest('.card-preview-wrapper');
      const img = parent?.querySelector('.preview-img') as HTMLImageElement | null;
      const cardId = downloadPngBtn.id.replace('btn-download-png-', '');
      if (!img || !img.src) return;

      try {
        const image = new Image();
        image.crossOrigin = 'anonymous';
        image.src = img.src;
        image.onload = () => {
          const canvas = document.createElement('canvas');
          const scale = 2; // 2x Retina PNG resolution
          canvas.width = (image.width || 495) * scale;
          canvas.height = (image.height || 215) * scale;
          const ctx = canvas.getContext('2d');
          if (ctx) {
            ctx.scale(scale, scale);
            ctx.drawImage(image, 0, 0);
            canvas.toBlob((blob) => {
              if (blob) {
                const url = URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url;
                a.download = `github-${currentUsername || 'user'}-${cardId}.png`;
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
                URL.revokeObjectURL(url);
                window.dispatchEvent(
                  new CustomEvent('app:toast', {
                    detail: { message: '¡Imagen PNG (Retina 2x) descargada!', type: 'success' }
                  })
                );
              }
            }, 'image/png');
          }
        };
      } catch (err) {
        console.error('Error downloading PNG:', err);
      }
    }
  });

  function sortCardsByStatus() {
    const container = document.querySelector('.cards-preview-container');
    if (!container) return;

    const wrappers = Array.from(
      container.querySelectorAll('.card-preview-wrapper')
    ) as HTMLElement[];

    const successCards: HTMLElement[] = [];
    const errorCards: HTMLElement[] = [];

    wrappers.forEach((wrapper) => {
      const placeholder = wrapper.querySelector('.placeholder-card');
      const hasErrorSvg = placeholder?.querySelector('svg.error') !== null;
      if (hasErrorSvg) {
        errorCards.push(wrapper);
      } else {
        successCards.push(wrapper);
      }
    });

    [...successCards, ...errorCards].forEach((wrapper) => container.appendChild(wrapper));
  }

