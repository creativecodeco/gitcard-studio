  function imageFinishedLoading() {
    if (!isGeneratingAllCards) return;

    completedImagesCount++;
    if (completedImagesCount >= totalImagesToLoad) {
      if (globalLoading) {
        globalLoading.classList.add('hidden');
      }
      sortCardsByStatus();
      updateSampleReadmeText();
      isGeneratingAllCards = false;
    }
  }

  // Update image previews and Markdown blocks
  function updateCards() {
    if (!currentUsername) return;

    applyPreviewWidth();
    isGeneratingAllCards = true;
    completedImagesCount = 0;
    if (globalLoading) {
      globalLoading.classList.remove('hidden');
    }

    const cardUrls = buildCardUrls({
      origin: window.location.origin,
      username: currentUsername,
      theme: currentTheme,
      cardWidth: currentCardWidth,
      locale: currentLocale,
      customColors: getCustomThemeQueryParams(),
      repo: currentRepo,
      viewsLabel: viewsLabel?.value,
      viewsColor: viewsColor?.value,
      viewsStyle: viewsStyle?.value
    });

    const {
      statsUrl,
      languagesUrl,
      rankUrl,
      streakUrl,
      trophiesUrl,
      topReposUrl,
      sponsorsUrl,
      commitActivityUrl,
      todayStatusUrl,
      timelineMatrixUrl,
      repoUrl,
