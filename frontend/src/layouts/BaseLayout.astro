---
import '../styles/global.css';
import PrivacyConsentBanner from '../components/PrivacyConsentBanner.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'GitCard Studio - Stats Generator | CreativeCode',
  description = 'Generador en tiempo real de tarjetas de estadísticas y lenguajes para tu perfil de GitHub y archivos README.'
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-9SV7XMX2Q1"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        window.dataLayer.push(arguments);
      }
      gtag('js', new Date());
      gtag('config', 'G-9SV7XMX2Q1');
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="gitcard studio, github stats, github readme stats, markdown generator, github profile stats, stats cards, github streak, programming languages, developer tools, open source, stats generator, github stats api, github stats generator, readme stats, github profile, github readme, github streak card, github languages card, fast github stats"
    />
    <link rel="canonical" href="https://gitcard-studio.creativecode.com.co/" />

    <!-- Hreflang Multilingual Indexing -->
    <link rel="alternate" hreflang="es" href="https://gitcard-studio.creativecode.com.co/" />
    <link
      rel="alternate"
      hreflang="en"
      href="https://gitcard-studio.creativecode.com.co/?locale=en"
    />
    <link rel="alternate" hreflang="x-default" href="https://gitcard-studio.creativecode.com.co/" />

    <!-- Structured Data (JSON-LD) for Search Engine Rich Snippets -->
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "WebApplication",
        "name": "GitCard Studio",
        "url": "https://gitcard-studio.creativecode.com.co/",
        "description": "Generador en tiempo real de tarjetas de estadísticas, lenguajes, rachas de contribución y matriz de actividad para tu perfil de GitHub y archivos README.",
        "applicationCategory": "DeveloperApplication",
        "operatingSystem": "Any",
        "browserRequirements": "Requires JavaScript",
        "softwareVersion": "1.7.1",
        "offers": {
          "@type": "Offer",
          "price": "0",
          "priceCurrency": "USD"
        },
        "author": {
          "@type": "Organization",
          "name": "CreativeCode",
          "url": "https://creativecode.com.co"
        },
        "featureList": [
          "Tarjetas de estadísticas de perfil de GitHub en tiempo real",
          "Matriz de hábitos de commit y distribución horaria",
          "Insignias de lenguajes de programación y trofeos",
          "Soporte para repositorios privados y organizaciones",
          "Badges y contadores de vistas personalizables en SVG"
        ]
      }
    </script>

    <!-- Robots and Indexing -->
    <meta
      name="robots"
      content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
    />

    <!-- Open Graph / Facebook / LinkedIn -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://gitcard-studio.creativecode.com.co/" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://gitcard-studio.creativecode.com.co/logo.png" />
    <meta
      property="og:image:secure_url"
      content="https://gitcard-studio.creativecode.com.co/logo.png"
    />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:site_name" content="GitCard Studio" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:url" content="https://gitcard-studio.creativecode.com.co/" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://gitcard-studio.creativecode.com.co/logo.png" />

    <!-- Favicon and Icons -->
    <link rel="icon" type="image/png" href="/logo.png" />
    <link rel="apple-touch-icon" href="/logo.png" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <!-- Global Loading Overlay -->
    <div id="global-loading" class="hidden global-loading">
      <div class="loading-content">
        <div class="loading-spinner">
          <svg class="spinner-svg" viewBox="0 0 50 50" width="50" height="50" aria-hidden="true">
            <circle
              class="path"
              cx="25"
              cy="25"
              r="20"
              fill="none"
              stroke-dasharray="80,200"
              stroke-width="5"></circle>
          </svg>
        </div>
        <p class="loading-text">Obteniendo datos de GitHub...</p>
        <p class="loading-subtext">Generando tus tarjetas personalizadas en tiempo real</p>
      </div>
    </div>

    <!-- Ambient background blobs -->
    <div class="blob blob-1"></div>
    <div class="blob blob-2"></div>
    <div class="blob blob-3"></div>

    <div class="app-container">
      <slot />
    </div>

    <PrivacyConsentBanner />
  </body>
</html>
