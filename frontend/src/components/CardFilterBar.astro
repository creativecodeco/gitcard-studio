<div class="card-filter-bar" id="card-filter-bar">
  <button class="filter-tab active" data-filter="all" type="button">
    <span class="tab-icon">🌟</span>
    <span class="tab-label" data-i18n="cat_all">Todas</span>
    <span class="filter-badge">12</span>
  </button>
  <button class="filter-tab" data-filter="stats" type="button">
    <span class="tab-icon">📊</span>
    <span class="tab-label" data-i18n="cat_stats">Estadísticas</span>
    <span class="filter-badge">4</span>
  </button>
  <button class="filter-tab" data-filter="activity" type="button">
    <span class="tab-icon">🔥</span>
    <span class="tab-label" data-i18n="cat_activity">Actividad</span>
    <span class="filter-badge">4</span>
  </button>
  <button class="filter-tab" data-filter="repos" type="button">
    <span class="tab-icon">📦</span>
    <span class="tab-label" data-i18n="cat_repos">Repositorios</span>
    <span class="filter-badge">3</span>
  </button>
  <button class="filter-tab" data-filter="badges" type="button">
    <span class="tab-icon">🏷️</span>
    <span class="tab-label" data-i18n="cat_badges">Badges</span>
