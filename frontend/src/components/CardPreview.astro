---
interface Props {
  id: string;
  title: string;
  placeholderMsg?: string;
  codeLabel: string;
  frameStyle?: string;
  imgStyle?: string;
  category?: string;
}

const {
  id,
  title,
  placeholderMsg = 'Ingresa tu usuario de GitHub para cargar la vista previa',
  codeLabel,
  frameStyle = '',
  imgStyle = '',
  category = 'all'
} = Astro.props;
---

<div class="card-preview-wrapper" data-category={category}>
  <h3 class="card-title-label" data-i18n={`title_${id}`}>{title}</h3>
  <div class="image-frame" id={`${id}-frame`} style={frameStyle}>
    <img
      id={`${id}-img`}
      alt={`Vista previa de ${title.toLowerCase()}`}
      class="hidden preview-img"
      style={imgStyle}
    />
    <div class="placeholder-card" id={`${id}-placeholder`}>
      <div class="pulse-icon">
        <slot name="placeholder-icon" />
      </div>
      <p data-i18n="placeholder_msg">{placeholderMsg}</p>
    </div>
  </div>
  <slot name="options" />
  <!-- Code Block -->
  <div class="hidden code-block-wrapper">
    <div class="code-container">
      <pre><code id={`markdown-${id}-code`}>Cargando...</code></pre>
      <button        class="copy-btn"
        id={`btn-copy-${id}`}
        aria-label={`Copiar markdown de ${codeLabel.toLowerCase()}`}
      >
        <svg
          class="icon-copy"
          viewBox="0 0 24 24"
          width="15"
          height="15"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
          <path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"></path>
        </svg>
        <svg
          class="hidden icon-check"
          viewBox="0 0 24 24"
          width="15"
          height="15"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
        <span class="copy-text" data-i18n="copy_btn">Copiar</span>
      </button>
    </div>

    <!-- Download Action Buttons -->
    <div class="download-actions" style="display: flex; gap: 8px; margin-top: 10px;">
      <button
        class="download-btn btn-download-svg"
        id={`btn-download-svg-${id}`}
        title="Descargar imagen SVG vectorial"
        style="flex: 1; height: 34px; padding: 0 12px; border-radius: 6px; border: 1px solid var(--glass-border); background: rgba(56,189,248,0.08); color: var(--text-primary); cursor: pointer; font-size: 0.78rem; font-weight: 600; display: flex; align-items: center; justify-content: center; gap: 6px; transition: all 0.2s;"
      >
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <polyline points="7 10 12 15 17 10"></polyline>
          <line x1="12" y1="15" x2="12" y2="3"></line>
        </svg>
        <span>Descargar SVG</span>
      </button>
      <button
        class="download-btn btn-download-png"
        id={`btn-download-png-${id}`}
        title="Descargar imagen PNG de alta resolución"
        style="flex: 1; height: 34px; padding: 0 12px; border-radius: 6px; border: 1px solid var(--glass-border); background: rgba(168,85,247,0.08); color: var(--text-primary); cursor: pointer; font-size: 0.78rem; font-weight: 600; display: flex; align-items: center; justify-content: center; gap: 6px; transition: all 0.2s;"
      >
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
          <circle cx="8.5" cy="8.5" r="1.5"></circle>
          <polyline points="21 15 16 10 5 21"></polyline>
        </svg>
        <span>Descargar PNG</span>
      </button>
    </div>
  </div>
</div>

<style>
  .download-btn {
    cursor: pointer !important;
    user-select: none;
  }
  .download-btn * {
    cursor: pointer !important;
    pointer-events: none;
  }
  .download-btn:hover {
    filter: brightness(1.2);
    transform: translateY(-1px);
    border-color: rgba(255, 255, 255, 0.25) !important;
  }
  .download-btn:active {
    transform: translateY(0);
    filter: brightness(0.95);
  }
</style>
