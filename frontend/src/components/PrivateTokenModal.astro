<script>
  // Dynamic client script for OAuth status & personal metrics handling
  function initPrivateTokenModal() {
    const urlParams = new URLSearchParams(window.location.search);
    const authSuccess = urlParams.get('auth_success');
    const authUsername = urlParams.get('username');

    const tokenUnregistered = document.getElementById('token-unregistered');
    const tokenRegistered = document.getElementById('token-registered');
    const connectedUsernameDisplay = document.getElementById('connected-username-display');
    const userAvatarInitial = document.getElementById('user-avatar-initial');
    const metricProfileViews = document.getElementById('metric-profile-views');
    const metricCardRenders = document.getElementById('metric-card-renders');
    const btnDisconnectAccount = document.getElementById('btn-disconnect-account');
    const btnOpenPurgeModal = document.getElementById('btn-open-purge-modal');
    const purgeModal = document.getElementById('purge-modal');
    const btnClosePurge = document.getElementById('btn-close-purge');
    const btnConfirmPurge = document.getElementById('btn-confirm-purge');
    const purgeUsernameInput = document.getElementById('purge-username') as HTMLInputElement;

    // Tab elements
    const modeTabPublic = document.getElementById('mode-tab-public');
    const modeTabApp = document.getElementById('mode-tab-app');
    const modeTabPat = document.getElementById('mode-tab-pat');

    const modePanePublic = document.getElementById('mode-pane-public');
    const modePaneApp = document.getElementById('mode-pane-app');
    const modePanePat = document.getElementById('mode-pane-pat');

    function switchModeTab(targetTab: string) {
      [modeTabPublic, modeTabApp, modeTabPat].forEach(btn => {
        if (btn) {
          btn.classList.remove('active');
          btn.style.background = 'transparent';
          btn.style.color = 'var(--text-secondary)';
        }
      });
      [modePanePublic, modePaneApp, modePanePat].forEach(pane => {
        if (pane) pane.classList.add('hidden');
      });

      if (targetTab === 'public' && modeTabPublic && modePanePublic) {
        modeTabPublic.classList.add('active');
        modeTabPublic.style.background = 'rgba(88, 166, 255, 0.2)';
        modeTabPublic.style.color = 'var(--text-primary)';
        modePanePublic.classList.remove('hidden');
      } else if (targetTab === 'app' && modeTabApp && modePaneApp) {
        modeTabApp.classList.add('active');
        modeTabApp.style.background = 'rgba(88, 166, 255, 0.2)';
        modeTabApp.style.color = 'var(--text-primary)';
        modePaneApp.classList.remove('hidden');
      } else if (targetTab === 'pat' && modeTabPat && modePanePat) {
        modeTabPat.classList.add('active');
        modeTabPat.style.background = 'rgba(88, 166, 255, 0.2)';
        modeTabPat.style.color = 'var(--text-primary)';
        modePanePat.classList.remove('hidden');
      }
    }

    modeTabPublic?.addEventListener('click', () => switchModeTab('public'));
    modeTabApp?.addEventListener('click', () => switchModeTab('app'));
    modeTabPat?.addEventListener('click', () => switchModeTab('pat'));

    let activeUser = authUsername || localStorage.getItem('gh_active_user') || localStorage.getItem('registered-github-username') || '';

    if (authSuccess === '1' && authUsername) {
      localStorage.setItem('gh_active_user', authUsername);
      localStorage.setItem('registered-github-username', authUsername);

      const cleanUrl = new URL(window.location.href);
      cleanUrl.searchParams.delete('auth_success');
      cleanUrl.searchParams.delete('username');
      window.history.replaceState({}, document.title, cleanUrl.pathname + (cleanUrl.search ? cleanUrl.search : ''));
    }

    const authTabsNav = document.getElementById('auth-tabs-nav');

    async function loadUserMetrics(username: string) {
      if (!username) return;
      try {
        const res = await fetch(`/api/users/me/metrics?username=${encodeURIComponent(username)}`);
        if (!res.ok) return;
        const data = await res.json();
        if (data && data.connected) {
          localStorage.setItem('gh_active_user', data.username);
          localStorage.setItem('registered-github-username', data.username);
          activeUser = data.username;

          tokenRegistered?.classList.remove('hidden');
          authTabsNav?.classList.add('hidden');
          [modePanePublic, modePaneApp, modePanePat].forEach(pane => {
            if (pane) pane.classList.add('hidden');
          });
          const usernameInput = document.getElementById('username-input') as HTMLInputElement;
          if (usernameInput) {
            usernameInput.value = data.username;
          }
          if (connectedUsernameDisplay) connectedUsernameDisplay.textContent = `@${data.username}`;
          if (userAvatarInitial) userAvatarInitial.textContent = data.username.charAt(0).toUpperCase();
          if (metricProfileViews) metricProfileViews.textContent = String(data.metrics.profile_views || 0);
          if (metricCardRenders) {
            const totalRenders = (data.metrics.stats_renders || 0) +
                                 (data.metrics.languages_renders || 0) +
                                 (data.metrics.repo_renders || 0) +
                                 (data.metrics.streak_renders || 0) +
                                 (data.metrics.rank_renders || 0) +
                                 (data.metrics.trophies_renders || 0) +
                                 (data.metrics.sponsors_renders || 0) +
                                 (data.metrics.commit_activity_renders || 0);
            metricCardRenders.textContent = String(totalRenders);
          }

          window.dispatchEvent(new CustomEvent('app:user-authenticated', { detail: { username: data.username } }));
        }
      } catch (err) {
        console.error('Error fetching user metrics:', err);
      }
    }

    if (activeUser) {
      loadUserMetrics(activeUser);
    }

    btnDisconnectAccount?.addEventListener('click', async (e) => {
      e.preventDefault();
      e.stopPropagation();

      const targetUser = (
        activeUser ||
        connectedUsernameDisplay?.textContent?.replace(/^@/, '').trim() ||
        localStorage.getItem('gh_active_user') ||
        localStorage.getItem('registered-github-username') ||
        ''
      ).trim();

      if (targetUser) {
        try {
          await fetch('/api/auth/disconnect', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ username: targetUser })
          });
        } catch (err) {
          console.error('Error disconnecting account:', err);
        }
      }

      localStorage.clear();
      sessionStorage.clear();

      if ('caches' in window) {
        try {
          const keys = await caches.keys();
          await Promise.all(keys.map((key) => caches.delete(key)));
        } catch (e) {
          console.warn('Could not clear CacheStorage:', e);
        }
      }

      activeUser = '';
      tokenRegistered?.classList.add('hidden');
      authTabsNav?.classList.remove('hidden');
      switchModeTab('public');

      window.dispatchEvent(new CustomEvent('app:user-disconnected', { detail: { username: targetUser } }));
    });

    function validatePurgeInput() {
      if (!purgeUsernameInput || !btnConfirmPurge) return;
      const typed = purgeUsernameInput.value.trim().toLowerCase();
      const target = activeUser.trim().toLowerCase();

      if (typed !== '' && (typed === target || typed === `@${target}`)) {
        btnConfirmPurge.removeAttribute('disabled');
        btnConfirmPurge.style.opacity = '1';
        btnConfirmPurge.style.pointerEvents = 'auto';
        btnConfirmPurge.style.cursor = 'pointer';
      } else {
        btnConfirmPurge.setAttribute('disabled', 'true');
        btnConfirmPurge.style.opacity = '0.5';
        btnConfirmPurge.style.pointerEvents = 'none';
        btnConfirmPurge.style.cursor = 'not-allowed';
      }
    }

    purgeUsernameInput?.addEventListener('input', validatePurgeInput);

    // Prevent paste and drag-and-drop to require manual typing confirmation
    purgeUsernameInput?.addEventListener('paste', (e) => {
      e.preventDefault();
    });

    purgeUsernameInput?.addEventListener('drop', (e) => {
      e.preventDefault();
    });

    btnOpenPurgeModal?.addEventListener('click', () => {
      purgeModal?.classList.remove('hidden');
      if (purgeUsernameInput) {
        purgeUsernameInput.value = '';
        purgeUsernameInput.focus();
      }
      validatePurgeInput();
    });

    btnClosePurge?.addEventListener('click', () => {
      purgeModal?.classList.add('hidden');
    });

    function triggerToast(message: string, type: 'success' | 'error' = 'success') {
      document.dispatchEvent(new CustomEvent('app:toast', { detail: { message, type } }));
    }

    btnConfirmPurge?.addEventListener('click', async () => {
      const usernameToPurge = purgeUsernameInput?.value.trim().replace(/^@/, '');
      if (!usernameToPurge) return;
      try {
        const res = await fetch(`/api/users/me?username=${encodeURIComponent(usernameToPurge)}`, {
          method: 'DELETE'
        });
        if (res.ok) {
          localStorage.removeItem('gh_active_user');
          localStorage.removeItem('registered-github-username');
          sessionStorage.clear();
          purgeModal?.classList.add('hidden');
          tokenRegistered?.classList.add('hidden');
          tokenUnregistered?.classList.remove('hidden');
          triggerToast('Tu cuenta y todos tus datos fueron eliminados correctamente.', 'success');
          setTimeout(() => {
            window.location.href = '/';
          }, 1200);
        } else {
          triggerToast('Error al intentar eliminar la cuenta.', 'error');
        }
      } catch (err) {
        console.error('Error purging account:', err);
        triggerToast('Error de red al intentar eliminar la cuenta.', 'error');
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPrivateTokenModal);
  } else {
    initPrivateTokenModal();
  }
</script>
