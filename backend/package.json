{
  "name": "gitcard-studio-backend",
  "version": "1.9.1",
  "description": "High-performance NestJS & Fastify API backend server for GitCard Studio SVG stats card generation, OAuth integration, and metrics tracking.",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start": "node dist/server.js",
    "dev": "ts-node-dev -r tsconfig-paths/register --respawn --transpile-only src/server.ts",
    "test": "vitest run",
    "test:typecheck": "tsc -p tsconfig.spec.json --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/static": "10.1.3",
    "@nestjs/common": "11.2.3",
    "@nestjs/core": "11.2.3",
    "@nestjs/platform-fastify": "11.2.3",
    "@resvg/resvg-js": "2.6.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "dotenv": "17.4.2",
    "fastify": "5.12.1",
    "ioredis": "6.0.0",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "typeorm": "1.1.0"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.3",
    "@types/node": "26.3.0",
    "@types/pg": "8.23.1",
    "ts-node-dev": "2.0.0",
    "tsc-alias": "1.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "overrides": {
    "brace-expansion": "5.0.8",
    "fastify": "5.12.1",
    "find-my-way": "9.7.0"
  }
}
